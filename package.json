{
  "name": "visual-learning-accessibility",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered visual-first learning platform for Deaf and hard-of-hearing students.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev:web": "npm run dev -w @visual-learning/web",
    "build:web": "npm run build -w @visual-learning/web",
    "lint:web": "npm run lint -w @visual-learning/web",
    "contracts:validate": "npm run validate -w @visual-learning/contracts",
    "contracts:generate": "npm run generate -w @visual-learning/contracts",
    "contracts:check": "npm run check -w @visual-learning/contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
