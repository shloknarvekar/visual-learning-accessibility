{
  "name": "@visual-learning/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, technology-neutral contracts (JSON Schema) between the API and the web app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lesson.schema.json": "./lesson.schema.json",
    "./examples/*": "./examples/*"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "check": "node scripts/generate-types.mjs --check",
    "validate": "node scripts/validate-examples.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0"
  }
}
