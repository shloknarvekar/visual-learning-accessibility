{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visual-learning:schema:lesson:0.1.0",
  "title": "Lesson",
  "description": "A structured, visual-first lesson built from educational source material. Every human-readable string is plain text: no HTML and no Markdown. Renderers choose presentation from each section's `type`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "overview", "source", "sections", "quiz"],
  "properties": {
    "schema_version": {
      "description": "Version of this contract. Changes that break existing consumers bump this value.",
      "const": "0.1.0"
    },
    "id": { "$ref": "#/$defs/Id" },
    "title": { "$ref": "#/$defs/PlainText" },
    "overview": { "$ref": "#/$defs/PlainText" },
    "source": { "$ref": "#/$defs/Source" },
    "sections": {
      "description": "Ordered lesson content. Render in array order.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Section" }
    },
    "quiz": {
      "description": "Checkpoint questions. May be empty.",
      "type": "array",
      "items": { "$ref": "#/$defs/QuizQuestion" }
    }
  },
  "$defs": {
    "Id": {
      "title": "Id",
      "description": "Identifier, unique within its parent collection. Safe for use in URLs and HTML ids.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "PlainText": {
      "title": "PlainText",
      "description": "Non-empty plain text. No HTML or Markdown.",
      "type": "string",
      "minLength": 1
    },
    "SourceType": {
      "title": "SourceType",
      "type": "string",
      "enum": ["youtube", "pdf"]
    },
    "Source": {
      "title": "Source",
      "description": "The material the lesson was generated from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "title"],
      "properties": {
        "source_type": { "$ref": "#/$defs/SourceType" },
        "title": { "$ref": "#/$defs/PlainText" },
        "url": {
          "description": "Original location, for example the YouTube video URL.",
          "type": "string",
          "format": "uri"
        },
        "filename": {
          "description": "Display name of an uploaded file. Sanitised by the API; never a server path.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SourceReference": {
      "title": "SourceReference",
      "description": "Points back to where content came from in the source. Use the locators that apply: page_number for PDFs, time range for videos.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "start_time_seconds": { "type": "number", "minimum": 0 },
        "end_time_seconds": { "type": "number", "minimum": 0 },
        "excerpt": {
          "description": "Short verbatim quote from the source.",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "Section": {
      "title": "Section",
      "description": "One block of lesson content. `type` determines the shape of `content`.",
      "oneOf": [
        { "$ref": "#/$defs/ConceptSection" },
        { "$ref": "#/$defs/ExplanationSection" },
        { "$ref": "#/$defs/ProcessSection" },
        { "$ref": "#/$defs/ComparisonSection" },
        { "$ref": "#/$defs/TimelineSection" },
        { "$ref": "#/$defs/ExampleSection" },
        { "$ref": "#/$defs/ConceptMapSection" },
        { "$ref": "#/$defs/DiagramSection" },
        { "$ref": "#/$defs/ChartSection" }
      ]
    },

    "ConceptSection": {
      "title": "ConceptSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "concept" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ConceptContent" }
      }
    },
    "ConceptContent": {
      "title": "ConceptContent",
      "description": "A key term with its definition.",
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": { "$ref": "#/$defs/PlainText" },
        "definition": { "$ref": "#/$defs/PlainText" },
        "key_points": { "type": "array", "items": { "$ref": "#/$defs/PlainText" } }
      }
    },

    "ExplanationSection": {
      "title": "ExplanationSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "explanation" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ExplanationContent" }
      }
    },
    "ExplanationContent": {
      "title": "ExplanationContent",
      "description": "A short, clear explanation in literal language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "$ref": "#/$defs/PlainText" },
        "key_points": { "type": "array", "items": { "$ref": "#/$defs/PlainText" } }
      }
    },

    "ProcessSection": {
      "title": "ProcessSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "process" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ProcessContent" }
      }
    },
    "ProcessContent": {
      "title": "ProcessContent",
      "description": "Ordered steps. Render in array order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ProcessStep" } }
      }
    },
    "ProcessStep": {
      "title": "ProcessStep",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/PlainText" },
        "description": { "$ref": "#/$defs/PlainText" }
      }
    },

    "ComparisonSection": {
      "title": "ComparisonSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "comparison" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ComparisonContent" }
      }
    },
    "ComparisonContent": {
      "title": "ComparisonContent",
      "description": "A comparison table. `items` are the things compared (columns); each row compares them on one criterion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "rows"],
      "properties": {
        "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/PlainText" } },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ComparisonRow" } }
      }
    },
    "ComparisonRow": {
      "title": "ComparisonRow",
      "description": "values[i] describes items[i]. The API guarantees values has the same length as items.",
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "values"],
      "properties": {
        "criterion": { "$ref": "#/$defs/PlainText" },
        "values": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/PlainText" } }
      }
    },

    "TimelineSection": {
      "title": "TimelineSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "timeline" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/TimelineContent" }
      }
    },
    "TimelineContent": {
      "title": "TimelineContent",
      "description": "Chronological events. Render in array order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TimelineEvent" } }
      }
    },
    "TimelineEvent": {
      "title": "TimelineEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "time_label", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "time_label": {
          "description": "Display label for when the event happens, for example \"1905\" or \"Stage 2\".",
          "$ref": "#/$defs/PlainText"
        },
        "title": { "$ref": "#/$defs/PlainText" },
        "description": { "$ref": "#/$defs/PlainText" }
      }
    },

    "ExampleSection": {
      "title": "ExampleSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "example" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ExampleContent" }
      }
    },
    "ExampleContent": {
      "title": "ExampleContent",
      "description": "A concrete scenario and how it connects to the lesson.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "explanation"],
      "properties": {
        "scenario": { "$ref": "#/$defs/PlainText" },
        "explanation": { "$ref": "#/$defs/PlainText" }
      }
    },

    "ConceptMapSection": {
      "title": "ConceptMapSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "concept_map" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ConceptMapContent" }
      }
    },
    "ConceptMapContent": {
      "title": "ConceptMapContent",
      "description": "Concepts (nodes) and labelled relationships between them (edges).",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "nodes", "edges"],
      "properties": {
        "summary": { "$ref": "#/$defs/VisualSummary" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/GraphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } }
      }
    },

    "DiagramSection": {
      "title": "DiagramSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "diagram" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/DiagramContent" }
      }
    },
    "DiagramContent": {
      "title": "DiagramContent",
      "description": "A structural diagram. `diagram_type` is a layout hint for the renderer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["diagram_type", "summary", "nodes", "edges"],
      "properties": {
        "diagram_type": { "type": "string", "enum": ["flowchart", "cycle", "hierarchy"] },
        "summary": { "$ref": "#/$defs/VisualSummary" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/GraphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } }
      }
    },

    "ChartSection": {
      "title": "ChartSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "chart" },
        "title": { "$ref": "#/$defs/PlainText" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } },
        "content": { "$ref": "#/$defs/ChartContent" }
      }
    },
    "ChartContent": {
      "title": "ChartContent",
      "description": "Numeric data from the source. Only used when the source contains real data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chart_type", "summary", "series"],
      "properties": {
        "chart_type": { "type": "string", "enum": ["bar", "line", "pie"] },
        "summary": { "$ref": "#/$defs/VisualSummary" },
        "x_axis_label": { "$ref": "#/$defs/PlainText" },
        "y_axis_label": { "$ref": "#/$defs/PlainText" },
        "unit": { "$ref": "#/$defs/PlainText" },
        "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ChartSeries" } }
      }
    },
    "ChartSeries": {
      "title": "ChartSeries",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "points"],
      "properties": {
        "name": { "$ref": "#/$defs/PlainText" },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ChartPoint" } }
      }
    },
    "ChartPoint": {
      "title": "ChartPoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/PlainText" },
        "value": { "type": "number" }
      }
    },

    "VisualSummary": {
      "title": "VisualSummary",
      "description": "Plain-language description of what a visual shows. Used as its text alternative.",
      "type": "string",
      "minLength": 1
    },
    "GraphNode": {
      "title": "GraphNode",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/PlainText" },
        "description": { "$ref": "#/$defs/PlainText" }
      }
    },
    "GraphEdge": {
      "title": "GraphEdge",
      "description": "A directed connection. from_id and to_id reference GraphNode ids in the same section; the API guarantees they exist.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "to_id"],
      "properties": {
        "from_id": { "$ref": "#/$defs/Id" },
        "to_id": { "$ref": "#/$defs/Id" },
        "label": {
          "description": "The relationship, read as \"<from> <label> <to>\", for example \"is absorbed by\".",
          "$ref": "#/$defs/PlainText"
        }
      }
    },

    "QuizQuestion": {
      "title": "QuizQuestion",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "options", "correct_option_id", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "multiple_choice" },
        "prompt": { "$ref": "#/$defs/PlainText" },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/QuizOption" } },
        "correct_option_id": {
          "description": "The id of the correct option. The API guarantees it matches an option.",
          "$ref": "#/$defs/Id"
        },
        "explanation": {
          "description": "Why the correct answer is correct. Shown after the learner answers.",
          "$ref": "#/$defs/PlainText"
        },
        "section_ids": {
          "description": "Sections this question checks understanding of, for linking back to review content.",
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/SourceReference" } }
      }
    },
    "QuizOption": {
      "title": "QuizOption",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "text": { "$ref": "#/$defs/PlainText" }
      }
    }
  }
}
