# Backend (services/api) configuration.
# Copy to `.env` in the repository root. `.env` is git-ignored: never commit real credentials.
# Frontend variables live in apps/web/.env.example (Next.js convention).
#
# Every value is optional. With nothing set, the API runs in mock mode and costs nothing.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI provider: gemini | mock
#   gemini  use the Google Gemini API free tier when GEMINI_API_KEY is set;
#           falls back to mock lessons when it is not
#   mock    never call an AI service; return deterministic example lessons
AI_PROVIDER=gemini

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Do not add a billing account or payment method.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Optional. Directory for local lesson storage. Defaults to services/api/.data
# DATA_DIR=
