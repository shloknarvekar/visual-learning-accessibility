# Backend (services/api) configuration.
# Copy to `.env` in the repository root. `.env` is git-ignored: never commit real credentials.
# Frontend variables live in apps/web/.env.example (Next.js convention).
#
# Every value is optional. With nothing set, the API runs in mock mode and costs nothing.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Primary AI provider: gemini | openrouter | groq | mock
#   mock never calls an AI service and always returns deterministic example lessons.
AI_PROVIDER=gemini

# Providers tried, in order, when the primary one is rate-limited or unavailable.
# Only providers whose API key is set are used. Set to an empty value to disable fallbacks.
AI_FALLBACK_PROVIDERS=openrouter,groq

# Reuse an earlier lesson for the same document when every provider is unavailable.
AI_CACHE_ENABLED=true
# Serve fixed demo content as the last resort instead of returning an error.
AI_FALLBACK_TO_DEMO=true

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Do not add a billing account or payment method.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Free API key from https://openrouter.ai/keys (no payment method needed for ":free" models).
OPENROUTER_API_KEY=
# Optional. Defaults to a free model that supports structured outputs.
OPENROUTER_MODEL=
# Optional attribution shown on openrouter.ai.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# Free API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to a model that supports strict JSON-schema output.
GROQ_MODEL=

# Optional. Directory for local lesson storage. Defaults to services/api/.data
# DATA_DIR=
